@model Ticketera.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewBag.Title = "Recuperar contraseña";
}

<div class="login-page">
    <div class="login-card">
        <h2 class="login-title">Recuperar contraseña</h2>
        <p class="login-subtitle">Ingresa tu usuario o correo registrado.</p>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-info alert-validation">
                @TempData["Mensaje"]
            </div>
        }

        @if (TempData["ResetLink"] != null)
        {
            <div class="alert alert-warning alert-validation">
                <strong>Enlace temporal:</strong><br />
                <a href="@TempData["ResetLink"]">@TempData["ResetLink"]</a>
            </div>
        }

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label-custom">Usuario o correo</label>
                @Html.TextBoxFor(m => m.UsuarioOEmail, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.UsuarioOEmail, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary btn-login">
                Generar enlace
            </button>

            <div style="margin-top:15px; text-align:center;">
                <a href="@Url.Action("Login", "Account")">Volver al login</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}