@model Ticketera.Models.ViewModels.ResetPasswordViewModel

@{
    ViewBag.Title = "Nueva contraseña";
}

<div class="login-page">
    <div class="login-card">
        <h2 class="login-title">Nueva contraseña</h2>
        <p class="login-subtitle">Ingresa tu nueva contraseña.</p>

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Token)

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger alert-validation" })

            <div class="form-group">
                <label class="form-label-custom">Nueva contraseña</label>
                @Html.PasswordFor(m => m.NuevaPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NuevaPassword, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label-custom">Confirmar contraseña</label>
                @Html.PasswordFor(m => m.ConfirmarPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConfirmarPassword, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary btn-login">
                Cambiar contraseña
            </button>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}