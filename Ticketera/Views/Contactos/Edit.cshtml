@model Ticketera.Models.Contacto

@{
    ViewBag.Title = "Editar contacto";
}

<style>
    .contacto-edit-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0;
    }

    .contacto-edit-header {
        background: linear-gradient(135deg, #1db7c1 0%, #22c58b 100%);
        color: white;
        border-radius: 22px;
        padding: 34px 36px;
        margin-bottom: 25px;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.16);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

        .contacto-edit-header h2 {
            margin: 0;
            font-weight: 900;
            font-size: 34px;
        }

        .contacto-edit-header p {
            margin: 8px 0 0 0;
            opacity: .95;
            font-size: 15px;
        }

    .edit-card {
        background: #ffffff;
        border-radius: 22px;
        padding: 28px;
        border: 1px solid #dbeafe;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
    }

    .section-title {
        font-size: 20px;
        font-weight: 900;
        color: #0f172a;
        margin-bottom: 22px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e5e7eb;
    }

    .form-label-custom {
        font-weight: 900;
        color: #334155;
        margin-bottom: 8px;
        display: block;
    }

    .required-star::after {
        content: " *";
        color: #dc2626;
    }

    .contacto-edit-page .form-control {
        width: 100%;
        max-width: 100%;
        border-radius: 14px;
        min-height: 44px;
        border: 1px solid #cbd5e1;
        box-shadow: none;
        padding: 10px 14px;
    }

        .contacto-edit-page .form-control:focus {
            border-color: #1db7c1;
            box-shadow: 0 0 0 3px rgba(29, 183, 193, .16);
        }

    .checks-box {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 16px;
        margin-top: 8px;
    }

    .check-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 800;
        color: #334155;
        margin-bottom: 10px;
    }

        .check-row:last-child {
            margin-bottom: 0;
        }

    .helper-text {
        color: #64748b;
        font-size: 12px;
        margin-top: 8px;
        font-weight: 600;
    }

    .footer-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .btn-action {
        border-radius: 14px;
        padding: 11px 18px;
        font-size: 14px;
        font-weight: 900;
        border: none;
        text-decoration: none !important;
        display: inline-block;
    }

    .btn-back {
        background: #e2e8f0;
        color: #334155 !important;
    }

        .btn-back:hover {
            background: #cbd5e1;
            color: #0f172a !important;
        }

    .btn-save {
        background: #22c58b;
        color: white !important;
        box-shadow: 0 10px 22px rgba(34, 197, 139, .22);
    }

        .btn-save:hover {
            background: #16a974;
            color: white !important;
        }

    .alert-validation {
        border-radius: 14px;
        padding: 14px 18px;
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .contacto-edit-header {
            text-align: center;
            justify-content: center;
        }

            .contacto-edit-header h2 {
                font-size: 28px;
            }

        .footer-actions {
            justify-content: center;
        }

        .btn-action {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="contacto-edit-page">

    <div class="contacto-edit-header">
        <div>
            <h2>Editar contacto</h2>
            <p>Actualiza los datos de la persona de contacto asociada a una empresa.</p>
        </div>
    </div>

    <div class="edit-card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(model => model.Id)
            @Html.Hidden("FechaRegistro", string.Format("{0:yyyy-MM-dd HH:mm:ss}", Model.FechaRegistro))

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger alert-validation" })

            <div class="section-title">Datos del contacto</div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label-custom required-star">Empresa</label>

                        @Html.DropDownListFor(
                            model => model.EntidadId,
                            (SelectList)ViewBag.EntidadId,
                            "-- Selecciona empresa --",
                            new { @class = "form-control" }
                        )

                        @Html.ValidationMessageFor(model => model.EntidadId, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-7">
                    <div class="form-group">
                        <label class="form-label-custom required-star">Nombre completo</label>

                        @Html.TextBoxFor(
                            model => model.Nombre,
                            new { @class = "form-control", placeholder = "Ej: Daniela Ramirez" }
                        )

                        @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="form-group">
                        <label class="form-label-custom">Cargo</label>

                        @Html.TextBoxFor(
                            model => model.Cargo,
                            new { @class = "form-control", placeholder = "Ej: Jefe de TI" }
                        )

                        @Html.ValidationMessageFor(model => model.Cargo, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-7">
                    <div class="form-group">
                        <label class="form-label-custom">Correo</label>

                        @Html.TextBoxFor(
                            model => model.Email,
                            new { @class = "form-control", type = "email", placeholder = "Ej: contacto@empresa.com" }
                        )

                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="form-group">
                        <label class="form-label-custom">Teléfono</label>

                        @Html.TextBoxFor(
                            model => model.Telefono,
                            new { @class = "form-control", placeholder = "Ej: 999888777" }
                        )

                        @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="checks-box">
                <label class="check-row">
                    @Html.CheckBoxFor(model => model.EsPrincipal)
                    Contacto principal
                </label>

                <label class="check-row">
                    @Html.CheckBoxFor(model => model.Activo)
                    Contacto activo
                </label>

                <div class="helper-text">
                    Fecha de registro: @string.Format("{0:dd/MM/yyyy HH:mm}", Model.FechaRegistro)
                </div>
            </div>

            <div class="footer-actions">
                <a href="@Url.Action("Index", "Contactos")" class="btn-action btn-back">
                    Cancelar
                </a>

                <button type="submit" class="btn-action btn-save">
                    Guardar cambios
                </button>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}